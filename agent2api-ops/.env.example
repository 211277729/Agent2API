# 复制成 .env（compose 自动读取），chmod 600 .env
#
# 当前部署的镜像 tag —— update.sh 会自动改这一行，回滚也改这一行。
IMAGE_TAG=local

# 面板管理员（首次启动写入库；密码明文填，服务启动时自动转 bcrypt）
A2A_ADMIN_USER=admin
A2A_ADMIN_PASSWORD=换成强密码

# 登录页人机验证：1 开 / 0 关
A2A_CAPTCHA=1

# Caddy 所在的 docker 网络（docker inspect <caddy容器> --format '{{json .NetworkSettings.Networks}}'）
CADDY_NETWORK=jingyu-api_jingyu-net
